{
  "name": "job-hunter-pro",
  "version": "1.0.0",
  "description": "Automated job hunting system — finds, scores and applies to jobs daily",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "run-hunt": "node src/runner.js",
    "parse-resume": "node src/parsers/resumeParser.js",
    "vercel-build": "echo 'skip'",
    "automation": "node src/automation/server.js",
    "automation:today": "node src/automation/server.js --run-today",
    "automation:discover": "node src/automation/cli.js discover",
    "automation:dry-run": "node src/automation/cli.js dry-run",
    "automation:apply": "node src/automation/cli.js apply",
    "test": "node --test test/*.test.js",
    "automation:check": "node scripts/check-automation.cjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "imapflow": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.38",
    "mammoth": "^1.13.0",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.64.0",
    "telegraf": "^4.15.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
