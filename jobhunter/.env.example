# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/jobhunter

# ── Telegram Bot (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Email Notifications (optional) ────────────────────────
EMAIL_FROM=gharshit192@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_TO=gharshit192@gmail.com

# ── Server ─────────────────────────────────────────────────
PORT=3000

# ── Job Search Config ──────────────────────────────────────
RESUME_PATH=./resume.pdf
DAILY_APPLY_LIMIT=10
MIN_MATCH_SCORE=70

# ── Personal application worker (Mac must remain awake) ─────────────────────
AUTOMATION_PORT=4129
# AUTOMATION_DATA_DIR=/absolute/path/to/private/job-hunter-data
AUTOMATION_BROWSER_CHANNEL=chrome
# Browser sessions run headless by default; use dashboard Open/Sign in only when needed.

# Workday candidate account used for sign-in / account creation
# WORKDAY_EMAIL=you@example.com
# WORKDAY_PASSWORD=
# WORKDAY_PASSWORD_LONG=   (12+ characters, for Citi/Fiserv-style tenants)
